# 환경변수 설정 예시
# 이 파일을 복사하여 .env.local 파일을 생성하세요
# cp .env.example .env.local

# 애플리케이션 기본 주소
NEXT_PUBLIC_API_URL=http://localhost:3000

# 환경 설정 (development, staging, production)
NEXT_PUBLIC_ENV=development

# PostgreSQL (로컬 Docker 기본값, 운영 비밀번호로 재사용 금지)
# 앱은 RLS가 적용되는 non-owner role, migration/worker는 별도 role을 사용합니다.
DATABASE_URL=postgresql://jumunpangpang_app:app@localhost:5432/jumunpangpang
MIGRATION_DATABASE_URL=postgresql://jumunpangpang_owner:owner@localhost:5432/jumunpangpang
WORKER_DATABASE_URL=postgresql://jumunpangpang_worker:worker@localhost:5432/jumunpangpang
ENABLED_MARKET_ADAPTERS=NAVER
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# 연동 비밀정보 암호화 키 (필수, base64로 인코딩한 32바이트 키)
# 생성 예시: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# 인증 공급자 연동 전 로컬 개발용 테넌트 컨텍스트
# production 환경에서는 이 값으로 인증을 우회할 수 없습니다.
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ID=00000000-0000-4000-8000-000000000001
ALLOW_INSECURE_DEV_AUTH=true

# 인증 프록시가 tenant/user/만료시간을 HMAC 서명할 때 쓰는 서버간 공유키 (최소 32자)
INTERNAL_AUTH_SHARED_SECRET=

# 자체 로그인용 HMAC 키와 세션 수명(5분~24시간). 내부 인증키와 다른 값을 사용합니다.
SESSION_SIGNING_SECRET=
SESSION_TTL_SECONDS=28800

# 최초 OWNER 생성/비밀번호 회전에만 사용합니다. 실행 후 비밀번호 값은 환경에서 제거하세요.
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_DISPLAY_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# 주문 목록 cursor 위변조 방지용 HMAC 키 (최소 32자, 인증키와 별도 값 권장)
CURSOR_SIGNING_SECRET=

# 마켓 API 주소 (테스트 더블/프록시가 아니면 기본값 사용)
NAVER_COMMERCE_API_BASE_URL=https://api.commerce.naver.com/external

# 소싱 상품·SKU 가격/재고 snapshot 최대 유효시간(1~3600초, 기본 900초)
SOURCING_FRESHNESS_MAX_SECONDS=900

# 워커 설정
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20

# NAVER automatic order collection scheduler
# Polling only checks whether an account is due; each account is enqueued no
# more often than NAVER_ORDER_SYNC_INTERVAL_MS after its last terminal run.
NAVER_SYNC_SCHEDULER_POLL_INTERVAL_MS=5000
NAVER_ORDER_SYNC_INTERVAL_MS=60000
NAVER_SYNC_SCHEDULER_BATCH_SIZE=100
NAVER_SCHEDULED_SYNC_MAX_ATTEMPTS=8

# Initial collection horizon and successful-watermark overlap
NAVER_INITIAL_LOOKBACK_MS=86400000
NAVER_SYNC_OVERLAP_SECONDS=300
